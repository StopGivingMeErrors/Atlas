# Atlas hosted E2E credentials - copy to your CI secret store or local shell.
# NEVER commit real values. The anon pair is public-by-design (it ships in the
# browser bundle); the remaining keys are runner-only and must never reach the
# client bundle or the repo.

# --- Required for any hosted verification -------------------------------
# Public project URL + anon key (Settings -> API in the Supabase dashboard).
ATLAS_E2E_SUPABASE_URL=https://<project-ref>.supabase.co
ATLAS_E2E_SUPABASE_ANON_KEY=<anon-key>

# Shared password for identities created by the harness (min 8 chars).
ATLAS_E2E_PASSWORD=<strong-shared-password>

# --- Optional: unlocks seeding, RLS/cross-org/storage suites ------------
# Service role key. RUNNER ONLY - playwright.config.ts deliberately keeps it
# out of the browser environment.
ATLAS_E2E_SERVICE_ROLE_KEY=<service-role-key>

# --- Optional: unlocks managed migration application --------------------
# Supabase management API token + explicit opt-in guard. Without these,
# schema changes stay a manual operator action and
# scripts/hosted-schema-verify.mjs reports what is missing instead.
ATLAS_E2E_ACCESS_TOKEN=<management-api-token>
ATLAS_E2E_ALLOW_MIGRATIONS=false
