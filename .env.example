# Atlas Identity Intelligence — environment configuration
#
# Copy to .env.local for local development. Never commit real credentials.

# --- Application API (required in production) ---
# Supabase project URL and anon key. The schema lives in supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Face detection provider (optional) ---
# HTTPS endpoint of the authorized backend vision service. When unset, the
# Capture workspace reports "Provider not configured." instead of simulating
# detections.
VITE_ATLAS_FACE_DETECTION_ENDPOINT=

# --- Identity matching provider (optional) ---
# Precedence: organization matching_provider_url (credentialless direct) ->
# proxy (secrets server-side in supabase/functions/identity-match) -> this
# legacy direct endpoint. DIRECT endpoints must NEVER embed credentials:
# everything prefixed VITE_ is compiled into the public browser bundle.
VITE_ATLAS_IDENTITY_MATCHING_ENDPOINT=
VITE_ATLAS_IDENTITY_MATCHING_PROXY_ENDPOINT=

# --- Public information / OSINT provider (optional) ---
# Same precedence model: organization connector endpoint_url (credentialless
# direct, category 'public_information') -> proxy (supabase/functions/
# public-information, holds PUBLIC_INFORMATION_PROVIDER_URL/_API_KEY in its
# own environment) -> this deployment direct endpoint. NEVER put provider
# API keys here.
VITE_ATLAS_PUBLIC_INFORMATION_ENDPOINT=
VITE_ATLAS_PUBLIC_INFORMATION_PROXY_ENDPOINT=

# --- Demo fixtures (development only) ---
# Set to true to run the UI against bundled fictional fixtures instead of a
# real backend. Leave empty to disable. Ignored entirely in production builds —
# production requires a configured provider and shows "Provider not configured."
# otherwise.
VITE_ATLAS_DEMO_FIXTURES=
